# Track only the portable project and its documentation at the root.
/*
!/.gitignore
!/.gitattributes
!/*.md
!/Assets/
!/Packages/
!/ProjectSettings/
!/Tools/
!/Docs/

# Unity generated / personal state. Keep ALL gameplay .meta files.
/Assets/Screenshots/
/Assets/Screenshots.meta
/Assets/_Recovery/
/Assets/_Recovery.meta
/Assets/StreamingAssets/aa/
/Assets/AddressableAssetsData/*/*.bin*
/Packages/.cache/
/Tools/*
!/Tools/UnityRequest.cjs
!/Tools/Package-Windows.ps1
!/Tools/HandGestures/

# IDE, credentials, local configuration and logs anywhere in tracked folders.
**/.vs/
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.pdb
*.mdb
*.log
*.tmp
*.bak
*.orig
.env
.env.*
*.pem
*.pfx
*.p12
*.key
*.keystore
*.jks
credentials.json

